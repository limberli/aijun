# Orchestrator base URL used by the Vite dev proxy (server-side, avoids CORS).
# All UI calls go through the /a2a proxy path → this target.
ORCHESTRATOR_URL=http://localhost:8080

# Plan / mode shown in the UI:
#   free  — Groq free tier (default): token limits + in-app token purchase
#   pro   — Groq paid tier
#   local — self-hosted model (Ollama): no limits, no billing prompts ("Local model" badge)
# Use `local` for the docker-compose-qwen.yml stack.
VITE_PLAN=free
